<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="uprofe_proyecto_investigacion_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-esc="doc.name" />
                        <p><strong>Título: </strong> <span t-esc="doc.sTitulo" /></p>
                        <p><strong>Presupuesto: </strong> <span t-esc="doc.fPresupuesto" /></p>
                        <p><strong>Título: </strong> <span t-esc="doc.sTitulo" /></p>
                        <p><strong>Inicio: </strong> <span t-field="doc.dFecha_inicio" /></p>
                        <p><strong>Fin: </strong> <span t-field="doc.dFecha_fin" /></p>

                        <div t-if="doc.publicacion_ids" class="row" style="margin-top:40px; font-weight: bold; font-size: 19px;">
                            Publicaciones asociadas
                        </div>
                        <div t-if="doc.publicacion_ids" id="publicaciones_asociadas" class="row" style="margin-top: 10px;">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Fecha de publicación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.publicacion_ids" t-as="publicacion">
                                        <tr>
                                            <td><p t-field="publicacion.sTitulo" /></td>
                                            <td><p t-field="publicacion.dFecha_publicacion" /></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
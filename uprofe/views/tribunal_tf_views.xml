<odoo>
    <!-- List -->
    <record id="view_tribunal_tf_list" model="ir.ui.view">
        <field name="name">uprofe.tribunal_tf.list</field>
        <field name="model">uprofe.tribunal_tf</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNum_tribunal"/>
                <field name="dFecha_constitucion"/>
                <field name="iNum_miembros"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_tribunal_tf_form" model="ir.ui.view">
        <field name="name">uprofe.tribunal_tf.form</field>
        <field name="model">uprofe.tribunal_tf</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos del tribunal">
                            <field name="sNum_tribunal"/>
                            <field name="dFecha_constitucion"/>
                        </group>
                        <group string="Resumen">
                            <field name="iNum_miembros"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Profesores (mínimo 3)">
                            <field name="profesor_ids">
                                <list>
                                    <field name="sDni"/>
                                    <field name="name" string="Nombre"/>
                                    <field name="sApellidos"/>
                                    <field name="email" string="Correo electrónico"/>
                                </list>
                            </field>
                        </page>
                        <page string="Investigadores">
                            <field name="investigador_ids">
                                <list>
                                    <field name="sDni"/>
                                    <field name="name" string="Nombre"/>
                                    <field name="sApellidos"/>
                                    <field name="sArea_investigacion"/>
                                </list>
                            </field>
                        </page>
                        <!-- DESCOMENTAR cuando defensa_tf esté en main y se descomente defensa_tf_ids en tribunal_tf.py
                        <page string="Defensas">
                            <field name="defensa_tf_ids" readonly="1">
                                <list>
                                    <field name="sNum_defensa"/>
                                    <field name="trabajo_final_id"/>
                                    <field name="dFecha"/>
                                    <field name="fHora" widget="float_time"/>
                                    <field name="espacio_id"/>
                                </list>
                            </field>
                        </page>
                        -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_tribunal_tf_search" model="ir.ui.view">
        <field name="name">uprofe.tribunal_tf.search</field>
        <field name="model">uprofe.tribunal_tf</field>
        <field name="arch" type="xml">
            <search>
                <field name="sNum_tribunal"/>
                <field name="dFecha_constitucion"/>
                <field name="profesor_ids"/>
                <field name="investigador_ids"/>
                <group string="Agrupar por">
                    <filter name="group_fecha" string="Fecha de constitución" context="{'group_by': 'dFecha_constitucion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="tribunal_tf_list_action" model="ir.actions.act_window">
        <field name="name">Tribunales de trabajo final</field>
        <field name="res_model">uprofe.tribunal_tf</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer tribunal</p>
        </field>
    </record>
</odoo>
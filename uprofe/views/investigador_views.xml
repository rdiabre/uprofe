<odoo>
    <!-- List -->
    <record id="view_investigador_list" model="ir.ui.view">
        <field name="name">uprofe.investigador.list</field>
        <field name="model">uprofe.investigador</field>
        <field name="arch" type="xml">
            <list>
                <field name="sDni"/>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="email" string="Correo electrónico"/>
                <field name="sOrcid"/>
                <field name="sArea_investigacion"/>
                <field name="iNum_publicaciones"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_investigador_form" model="ir.ui.view">
        <field name="name">uprofe.investigador.form</field>
        <field name="model">uprofe.investigador</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- Herencia de Persona -->
                        <group string="Datos personales">
                            <!-- Si la persona ya existe, se elige aquí y se rellenan sus datos. Si no, se deja vacío y se crea al guardar -->
                            <field name="persona_id" string="Persona existente" required="0"/>
                            <field name="sDni"/>
                            <field name="name" string="Nombre"/>
                            <field name="sApellidos"/>
                            <field name="email" string="Correo electrónico" required="1"/>
                            <field name="phone" string="Teléfono" required="1"/>
                            <field name="direccion_id"/>
                        </group>
                        <!-- Campos propios -->
                        <group string="Datos del investigador">
                            <field name="sOrcid" placeholder="0000-0000-0000-0000"/>
                            <field name="sArea_investigacion"/>
                            <field name="iNum_lineas"/>
                            <field name="iNum_publicaciones"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de investigación">
                            <field name="linea_investigacion_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Publicaciones">
                            <field name="publicacion_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="sTitulo"/>
                                </list>
                            </field>
                        </page>
                        <!-- DESCOMENTAR cuando tribunal_tf esté en main y se descomente tribunal_tf_ids en investigador.py
                        <page string="Tribunales">
                            <field name="tribunal_tf_ids" widget="many2many_tags"/>
                        </page>
                        -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_investigador_search" model="ir.ui.view">
        <field name="name">uprofe.investigador.search</field>
        <field name="model">uprofe.investigador</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="sDni"/>
                <field name="sOrcid"/>
                <field name="sArea_investigacion"/>
                <group string="Agrupar por">
                    <filter name="group_area" string="Área de investigación" context="{'group_by': 'sArea_investigacion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="investigador_list_action" model="ir.actions.act_window">
        <field name="name">Investigadores</field>
        <field name="res_model">uprofe.investigador</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer investigador</p>
        </field>
    </record>
</odoo>
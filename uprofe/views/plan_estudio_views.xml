<odoo>
    <!-- List -->
    <record id="view_plan_estudio_list" model="ir.ui.view">
        <field name="name">uprofe.plan_estudio.list</field>
        <field name="model">uprofe.plan_estudio</field>
        <field name="arch" type="xml">
            <list>
                <field name="titulacion_id"/>
                <field name="sCurso_academico"/>
                <field name="bEs_actual"/>
                <field name="sNombre_fichero"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_plan_estudio_form" model="ir.ui.view">
        <field name="name">uprofe.plan_estudio.form</field>
        <field name="model">uprofe.plan_estudio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos del plan">
                            <field name="titulacion_id"/>
                            <field name="sCurso_academico"/>
                            <field name="bEs_actual"/>
                        </group>
                        <group string="Documento (PDF)">
                            <field name="binFichero" filename="sNombre_fichero"/>
                            <field name="sNombre_fichero" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trabajos finales">
                            <field name="trabajo_final_ids" readonly="1">
                                <list>
                                    <field name="sNum_tf"/>
                                    <field name="sTitulo"/>
                                    <field name="alumno_id"/>
                                    <field name="profesor_id"/>
                                    <field name="sCurso_academico"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_plan_estudio_search" model="ir.ui.view">
        <field name="name">uprofe.plan_estudio.search</field>
        <field name="model">uprofe.plan_estudio</field>
        <field name="arch" type="xml">
            <search>
                <field name="titulacion_id"/>
                <field name="sCurso_academico"/>
                <group string="Agrupar por">
                    <filter name="group_titulacion" string="Titulación" context="{'group_by': 'titulacion_id'}"/>
                    <filter name="group_curso" string="Curso académico" context="{'group_by': 'sCurso_academico'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="plan_estudio_list_action" model="ir.actions.act_window">
        <field name="name">Planes de estudio</field>
        <field name="res_model">uprofe.plan_estudio</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer plan de estudio</p>
        </field>
    </record>
</odoo>